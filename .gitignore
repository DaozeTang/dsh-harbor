# Dependencies
node_modules/

# Build output — lib/ by `npm run build`, preview/out by `preview:ui`,
# release/ by `pack:release`; never committed
lib/
preview/out/
release/

# Ad-hoc verification screenshots and reports; no npm script writes here
# (the preview's ?capture flag writes under preview/out instead)
verify/
.playwright-cli/

# Manual integration tests need a live SSH server with credentials; not for CI
test/manual/

# Generated per-machine host key for the local test server (test-sshd.mjs)
test-sshd-hostkey.pem

# Tool and editor noise
.DS_Store
*.tgz
npm-debug.log*
package-lock.json.bak-*
