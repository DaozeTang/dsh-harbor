{
  "name": "dsh-harbor",
  "version": "0.6.0",
  "description": "Drive remote servers from the conversation: interactive terminal, remote files, port forwarding, snippets and session logs.",
  "icon": "./icon.svg",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ssh",
    "terminal",
    "xterm",
    "remote",
    "sftp",
    "tunnel"
  ],
  "type": "module",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./typert": {
      "default": "./lib/typert.js"
    },
    "./remote": {
      "default": "./lib/remote.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./terminal-backend": {
      "default": "./lib/terminal-backend.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/assets/*.png",
    "docs/product-guide.md",
    "docs/ui-guidelines.md",
    "docs/icon-pipeline.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.3-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-rc.1"
  },
  "peerDependenciesMeta": {},
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
    "@eslint/js": "^10.0.1",
    "@noble/hashes": "1.8.0",
    "@types/node": "26.2.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/xterm": "5.5.0",
    "esbuild": "^0.28.2",
    "espree": "^11.2.0",
    "zod": "^4.6.7",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:host && npm run build:client",
    "clean": "node -e \"for (const p of ['lib','preview/out','release']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "prepare": "npm run build",
    "lint": "eslint .",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "test": "node scripts/run-tests.mjs",
    "preview:ui": "node scripts/build-preview.mjs",
    "theme:snapshot": "node scripts/sync-theme-snapshot.mjs",
    "install:dev": "node scripts/install-dev.mjs",
    "pack:release": "npm run build && node scripts/package-release.mjs"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
